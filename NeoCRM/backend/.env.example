# Copy to .env and fill in values before running

# --- App ---
APP_NAME=NeoCRM API
ENVIRONMENT=development
DEBUG=false

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://neocrm:neocrm_dev@localhost:5432/neocrm

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- First superadmin (used by seeder on first startup) ---
FIRST_SUPERADMIN_EMAIL=admin@neocrm.local
FIRST_SUPERADMIN_PASSWORD=changeme123
FIRST_ORG_NAME=NeoCRM

# --- DB app role (for REVOKE privileges on audit_logs) ---
DB_APP_ROLE=neocrm
